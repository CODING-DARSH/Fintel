# =============================================================================
# .gitignore — Fintel Platform
# =============================================================================

# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ── Data — too large for git, managed via Docker volumes ──────────────────────
data/raw/
data/processed/
data/labels/

# ── Outputs — regenerated by running the pipeline ─────────────────────────────
outputs/
logs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/*.ipynb

# ── ML model cache ────────────────────────────────────────────────────────────
# HuggingFace models are large — cached in Docker volume, not repo
.cache/
*.bin
*.safetensors

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.html
Pipeline_DOCS.md
roadmap.txt
rem.txt
*data/
Designed_for.txt
Model_training_Roadmap.txt
reasons.txt